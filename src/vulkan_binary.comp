#version 450

// One invocation handles four adjacent FP32 values.  PP-OCR feature maps are
// contiguous NCHW planes, so this maps naturally to vec4 loads/stores and
// reduces dispatch bookkeeping without changing the scalar tail semantics.
// The Y dimension remains the independent crop-batch index.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// InputA is also the result storage.  Every invocation owns a disjoint
// contiguous four-float span, reads it before writing it, and never needs an
// inter-invocation dependency.  Keeping the result in this mapped input
// buffer removes a whole activation buffer and the device-to-host copy into a
// third staging buffer for the synchronous hybrid path.
layout(std430, binding = 0) buffer InputA { float a[]; };
// Most graph modes treat B as immutable weights/another activation.  The
// device DB post-process mode also uses it as its on-device connectivity
// scratch map, so it must be writable in the shared descriptor ABI.
layout(std430, binding = 1) buffer InputB { float b[]; };
// Binding C is normally read-only bias/affine data. Mode 38 uses it as the
// third QKV output; keeping the declaration writable is legal for all other
// modes and avoids a second pipeline solely for that graph-local transform.
layout(std430, binding = 2) buffer InputC { float c[]; };
layout(std430, binding = 3) buffer OutputD { float d[]; };
// Binding E is normally a read-only residual. Mode 38 uses it as the K QKV
// output; writable storage preserves all existing reads and avoids a second
// descriptor/pipeline layout for a graph-local transform.
layout(std430, binding = 4) buffer ResidualE { float e[]; };

// The pointwise-convolution modes stage learned [M,C] weights in workgroup
// memory. One workgroup maps to four output channels and 256 adjacent spatial
// positions per channel, so its four weight rows are reused by all 64 vec4
// producing lanes. Four channels x 1024 input channels consumes 16 KiB, the
// Vulkan guaranteed shared-memory floor. Wider layers take the generic path.
shared float pointwise_weights[4096];
// Depthwise convolution has one small [KH,KW] filter per channel.  Assigning
// a workgroup to a single output channel lets all its output positions reuse
// that filter from workgroup memory rather than fetching it once per pixel.
// PP-OCRv6's depthwise kernels are at most 9x9; keep a conservative 16x16
// cache and transparently retain global loads for a larger exported kernel.
shared float depthwise_weights[256];
// Ordinary detector convolutions use the same output channel over a spatial
// tile.  For the common 3x3/2x2 projections this makes the entire [C,KH,KW]
// filter small enough to stage once per workgroup instead of rereading it for
// every output pixel.  Larger exports transparently take the generic path.
shared float conv_weights[4096];
// 16x16 output tile halo for 3x3 s1/s2. 4096 floats is the guaranteed 16 KiB
// shared-memory floor: s1 18x18 stages 12 IC/pass (Concat.2 C=64), s2 34x34
// stages 3 IC/pass (stem pool-concat C=32).
shared float conv_spatial_tile[4096];
// Row-transform workgroups use these only in the parallel Softmax branch.
shared float softmax_row_max;
shared float softmax_row_inverse_sum;
// Terminal CTC's vocabulary rows are much wider than its sequence count.
// Reduce one row cooperatively: the recognizer commonly has only a few dozen
// time steps but up to several thousand classes, so a one-thread-per-row
// implementation leaves nearly the whole GPU idle on small/medium models.
shared float ctc_row_max[256];
shared float ctc_row_sum[256];
shared uint ctc_row_best[256];

layout(push_constant) uniform Params {
  uint count;
  uint batches;
  uint operation0;
  uint operation1;
  uint operation2;
  uint operation3;
  uint steps;
  uint right_repeat;
  // Number of compact RHS values needed for one output batch and the
  // distance to the next batch's RHS.  A zero stride means the same model
  // constant (for example [1,C,1,1]) is shared by every input crop.
  uint right_per_batch;
  uint right_batch_stride;
  // mode=0 is the existing one-RHS binary chain. mode=1 is a fused channel
  // affine, mode=2 adds its exact Swish activation; b is scale and c is bias
  // with the same compact layout in both affine modes. Modes 3/4 are NCHW
  // 1x1 Conv (+ ReLU in mode 4), modes 5/6 additionally add the equal-shape
  // residual from binding E before optional ReLU: `count` is output values per batch,
  // `right_repeat` the spatial plane, `right_per_batch` input channels and
  // `right_batch_stride` output channels. Mode 7 is the same pointwise Conv
  // with exact Swish fused into the output write. Mode 10 fuses exact Sigmoid.
  // Mode 11 fuses ONNX HardSigmoid; operation0/operation1 carry the raw FP32
  // alpha/beta bits so detector gates keep their exported parameters exactly.
  // Mode 8 performs affine +
  // Swish then a same-shape binary op, using binding D as the second live
  // activation so the intermediate stays device-resident. Mode 9 is pointwise
  // Conv + residual Add + exact Swish in one output write. Mode 12 is the
  // detector's exact HardSwish: `x * clamp(alpha*x+beta, 0, 1)`, where
  // operation0/operation1 carry alpha/beta raw FP32 bits.
  // Mode 13 is a regular NCHW depthwise convolution.  `count` is output
  // values per batch, `right_repeat`/`right_per_batch` are input H/W,
  // `right_batch_stride`/`steps` are output H/W, and operation0..3 carry
  // kernel H/W and stride H/W. `b` contains [C,KH,KW], `c` contains [C].
  // The high 16 bits of mode carry non-negative top/left padding; low bits
  // retain the mode identifier. Mode 29 is the second dispatch in a
  // depthwise->pointwise chain: it reads the intermediate from D and writes
  // the final result into A. E then packs [M,C] weights followed by [M] bias.
  uint mode;
} params;

vec4 apply_binary(vec4 left, vec4 right, uint operation) {
  if (operation == 0u) return left + right;
  if (operation == 1u) return left - right;
  if (operation == 2u) return left * right;
  return left / right;
}

float apply_binary_scalar(float left, float right, uint operation) {
  if (operation == 0u) return left + right;
  if (operation == 1u) return left - right;
  if (operation == 2u) return left * right;
  return left / right;
}

// Matches the opt-in AVX2/AVX-512 GELU approximation. This is selected only
// for the same x86 policy/shape that kernels::Gelu() selects; default ONNX
// Erf-GELU never enters this shader path.
vec4 approximate_gelu(vec4 x) {
  const vec4 z = vec4(0.7978845608028654) *
      (x + vec4(0.044715) * x * x * x);
  const vec4 z2 = z * z;
  const vec4 t = clamp(z * (vec4(27.0) + z2) /
                       (vec4(27.0) + vec4(9.0) * z2), vec4(-1.0), vec4(1.0));
  return vec4(0.5) * x * (vec4(1.0) + t);
}

float approximate_gelu_scalar(float x) {
  const float z = 0.7978845608028654 * (x + 0.044715 * x * x * x);
  const float z2 = z * z;
  const float t = clamp(z * (27.0 + z2) / (27.0 + 9.0 * z2), -1.0, 1.0);
  return 0.5 * x * (1.0 + t);
}

// GLSL 450 does not expose an Erf intrinsic. This well-conditioned
// Abramowitz/Stegun complementary-error-function polynomial has a maximum
// absolute error below 1.5e-7 for FP32 inputs, substantially tighter than
// the optional tanh GELU approximation used by CPU SIMD fusions.
float erf_fp32(float x) {
  const float sign = x < 0.0 ? -1.0 : 1.0;
  const float ax = abs(x);
  const float t = 1.0 / (1.0 + 0.5 * ax);
  const float polynomial = -1.26551223 + t * (1.00002368 + t * (0.37409196 +
      t * (0.09678418 + t * (-0.18628806 + t * (0.27886807 +
      t * (-1.13520398 + t * (1.48851587 + t * (-0.82215223 + t * 0.17087277))))))));
  return sign * (1.0 - t * exp(-ax * ax + polynomial));
}

void main() {
  // Mode 54 is the complete detector DB post-process.  It intentionally uses
  // one GPU invocation: detector maps are compact (normally <= 240x240), and
  // this deterministic raster flood-fill exactly retains the CPU DB rules
  // without downloading the FP32 probability map. Binding A is one detector
  // N-plane, B is device-only state, and C returns only
  // [count, x0,y0,x1,y1,score ...].  It is a control/data-reduction kernel,
  // not a CPU inference fallback.
  if (params.mode == 54u) {
    if (gl_GlobalInvocationID.x != 0u || gl_GlobalInvocationID.y != 0u) return;
    const uint height = params.right_repeat;
    const uint width = params.right_per_batch;
    const uint image_width = params.operation3;
    const uint image_height = params.steps;
    const uint capacity = params.right_batch_stride;
    const uint elements = params.count;
    if (height == 0u || width == 0u || image_width == 0u || image_height == 0u ||
        elements != height * width || capacity == 0u) return;
    const float threshold = uintBitsToFloat(params.operation0);
    const float box_threshold = uintBitsToFloat(params.operation1);
    const float unclip_ratio = uintBitsToFloat(params.operation2);
    // 0 background/finished, 1 unseen foreground, 2 flood frontier,
    // 3 current component.  The second half of B is a device-only FIFO of
    // pixel indices, giving linear-time component traversal instead of a
    // repeated whole-map wave scan. State never crosses the host boundary.
    for (uint i = 0u; i < elements; ++i) b[i] = a[i] > threshold ? 1.0 : 0.0;
    uint result_count = 0u;
    for (uint start = 0u; start < elements; ++start) {
      if (b[start] != 1.0) continue;
      b[start] = 2.0;
      uint head = 0u, tail = 1u;
      b[elements] = float(start);
      uint min_x = width, max_x = 0u, min_y = height, max_y = 0u, pixels = 0u;
      float sum = 0.0;
      while (head < tail) {
        const uint index = uint(b[elements + head++]);
        b[index] = 3.0;
        const uint y = index / width, x = index - y * width;
        min_x = min(min_x, x); max_x = max(max_x, x);
        min_y = min(min_y, y); max_y = max(max_y, y);
        sum += a[index]; ++pixels;
        const int ix = int(x), iy = int(y);
        for (int dy = -1; dy <= 1; ++dy) for (int dx = -1; dx <= 1; ++dx) {
          if (dx == 0 && dy == 0) continue;
          const int nx = ix + dx, ny = iy + dy;
          if (nx >= 0 && nx < int(width) && ny >= 0 && ny < int(height)) {
            const uint neighbor = uint(ny) * width + uint(nx);
            if (b[neighbor] == 1.0) {
              b[neighbor] = 2.0;
              b[elements + tail++] = float(neighbor);
            }
          }
        }
      }
      // Release just this component's FIFO/state slots, preserving a linear
      // traversal even on dense detector maps with many independent blobs.
      for (uint item = 0u; item < tail; ++item) b[uint(b[elements + item])] = 0.0;
      if (pixels == 0u) continue;
      const float score = sum / float(pixels);
      if (score < box_threshold) continue;
      const float bw = float(max_x - min_x + 1u), bh = float(max_y - min_y + 1u);
      const float expand = max(1.0, unclip_ratio * sqrt(bw * bh) * 0.15);
      const float x0 = clamp(float(min_x) - expand, 0.0, float(width - 1u));
      const float x1 = clamp(float(max_x) + expand, 0.0, float(width - 1u));
      const float y0 = clamp(float(min_y) - expand, 0.0, float(height - 1u));
      const float y1 = clamp(float(max_y) + expand, 0.0, float(height - 1u));
      if (min(x1 - x0, y1 - y0) < 3.0 || result_count >= capacity) continue;
      const uint base = 1u + result_count * 5u;
      c[base] = x0 * float(image_width) / float(width);
      c[base + 1u] = y0 * float(image_height) / float(height);
      c[base + 2u] = x1 * float(image_width) / float(width);
      c[base + 3u] = y1 * float(image_height) / float(height);
      c[base + 4u] = score;
      ++result_count;
    }
    // Match the public OCR ordering policy on-device before recognition jobs
    // are built. It is an insertion sort because DB returns few boxes in the
    // usual document case and avoids a host-side geometry pass.
    for (uint i = 1u; i < result_count; ++i) {
      const uint current = 1u + i * 5u;
      const float x0 = c[current], y0 = c[current + 1u], x1 = c[current + 2u],
                  y1 = c[current + 3u], score = c[current + 4u];
      uint j = i;
      while (j > 0u) {
        const uint previous = 1u + (j - 1u) * 5u;
        const bool before = abs(y0 - c[previous + 1u]) < 10.0
            ? x0 < c[previous] : y0 < c[previous + 1u];
        if (!before) break;
        const uint target = 1u + j * 5u;
        for (uint field = 0u; field < 5u; ++field) c[target + field] = c[previous + field];
        --j;
      }
      const uint target = 1u + j * 5u;
      c[target] = x0; c[target + 1u] = y0; c[target + 2u] = x1;
      c[target + 3u] = y1; c[target + 4u] = score;
    }
    c[0] = float(result_count);
    return;
  }
  // Mode 45 is the medium detector tail's conservative depthwise path.  The
  // `896x5x22` layer has too little spatial work for a vec4 workgroup to be
  // useful, and this scalar indexing avoids a Radeon/LLPC device-loss seen
  // after the full preceding graph.  It is algebraically the same FP32
  // depthwise convolution as mode 13, with one invocation per output value.
  if ((params.mode & 0xffffu) == 52u || (params.mode & 0xffffu) == 53u) {
    const uint batch = gl_GlobalInvocationID.y;
    // Mode 53 is the segmented variant used for the Radeon-sensitive
    // detector tail.  Unlike mode 52 it keeps the original whole-buffer
    // descriptors and carries only a channel window in the high mode bits.
    // This avoids changing storage-buffer descriptor offsets between four
    // otherwise identical dispatches on drivers that aggressively cache
    // descriptor metadata.  The tensor never leaves device memory.
    const uint channel_begin = (params.mode & 0xffffu) == 53u
        ? (params.mode >> 16u) : 0u;
    const uint output_index = gl_GlobalInvocationID.x + channel_begin * params.steps * params.right_batch_stride;
    const uint input_h = params.right_repeat;
    const uint input_w = params.right_per_batch;
    const uint output_h = params.right_batch_stride;
    const uint output_w = params.steps;
    const uint kernel_h = params.operation0;
    const uint kernel_w = params.operation1;
    const uint stride_h = params.operation2;
    const uint stride_w = params.operation3;
    // Mode 53 qualifies only the exported 3x3 pad-one detector tail.  Its
    // upper bits carry channel_begin, so retain that fixed padding locally.
    const uint pad_top = (params.mode & 0xffffu) == 53u ? 1u : (params.mode >> 16u) & 0xffu;
    const uint pad_left = (params.mode & 0xffffu) == 53u ? 1u : (params.mode >> 24u) & 0xffu;
    if (batch >= params.batches || output_index >= params.count || input_h == 0u ||
        input_w == 0u || output_h == 0u || output_w == 0u || kernel_h == 0u ||
        kernel_w == 0u || stride_h == 0u || stride_w == 0u) return;
    const uint input_plane = input_h * input_w;
    const uint output_plane = output_h * output_w;
    const uint channel = output_index / output_plane;
    const uint spatial = output_index - channel * output_plane;
    const uint output_y = spatial / output_w;
    const uint output_x = spatial - output_y * output_w;
    const int input_y = int(output_y * stride_h) - int(pad_top);
    const int input_x = int(output_x * stride_w) - int(pad_left);
    float value = c[channel];
    const uint input_base = (batch * (params.count / output_plane) + channel) * input_plane;
    const uint weight_base = channel * kernel_h * kernel_w;
    for (uint ky = 0u; ky < kernel_h; ++ky) {
      const int y = input_y + int(ky);
      if (y < 0 || y >= int(input_h)) continue;
      for (uint kx = 0u; kx < kernel_w; ++kx) {
        const int x = input_x + int(kx);
        if (x >= 0 && x < int(input_w)) {
          value += a[input_base + uint(y) * input_w + uint(x)] *
              b[weight_base + ky * kernel_w + kx];
        }
      }
    }
    d[batch * params.count + output_index] = value;
    return;
  }
  // Mode 32 is the GPU-only graph executor's in-place unary activation.
  // `operation0`: ReLU, Sigmoid, Swish, HardSigmoid, HardSwish, GELU, Sqrt,
  // Square. `operation1`
  // and `operation2` preserve ONNX HardSigmoid's alpha/beta bits exactly.
  if (params.mode == 32u) {
    const uint index = gl_GlobalInvocationID.x * 4u;
    const uint batch = gl_GlobalInvocationID.y;
    if (batch >= params.batches || index >= params.count) return;
    const uint offset = batch * params.count + index;
    for (uint lane = 0u; lane < 4u && index + lane < params.count; ++lane) {
      float value = a[offset + lane];
      if (params.operation0 == 0u) value = max(value, 0.0);
      else if (params.operation0 == 1u) value = 1.0 / (1.0 + exp(-value));
      else if (params.operation0 == 2u) value *= 1.0 / (1.0 + exp(-value));
      else if (params.operation0 == 3u) value = clamp(uintBitsToFloat(params.operation1) * value +
                                                       uintBitsToFloat(params.operation2), 0.0, 1.0);
      else if (params.operation0 == 4u) value *= clamp(uintBitsToFloat(params.operation1) * value +
                                                       uintBitsToFloat(params.operation2), 0.0, 1.0);
      else if (params.operation0 == 5u) value = 0.5 * value * (1.0 + erf_fp32(value * 0.7071067811865475));
      else if (params.operation0 == 6u) value = sqrt(value);
      else value *= value;
      a[offset + lane] = value;
    }
    return;
  }
  // Mode 41 is a contiguous suffix broadcast.  It deliberately writes to D
  // (rather than aliasing A): graph liveness may require both inputs after a
  // residual/SE branch. `right_repeat` is the scalar span of a compact RHS
  // value, `right_per_batch` is its item count, and zero batch stride denotes
  // a shared model constant.
  if (params.mode == 41u) {
    const uint index = gl_GlobalInvocationID.x * 4u;
    const uint batch = gl_GlobalInvocationID.y;
    if (batch >= params.batches || index >= params.count || params.right_repeat == 0u ||
        params.right_per_batch == 0u) return;
    const uint rhs_base = params.right_batch_stride == 0u ? 0u : batch * params.right_batch_stride;
    const uint base = batch * params.count;
    for (uint lane = 0u; lane < 4u && index + lane < params.count; ++lane) {
      const float lhs = a[base + index + lane];
      const float rhs = b[rhs_base + ((index + lane) / params.right_repeat)];
      d[base + index + lane] = apply_binary_scalar(lhs, rhs, params.operation0);
    }
    return;
  }
  // Mode 42 concatenates up to four contiguous tensors. Bindings A/B/C/E
  // supply the inputs and D is the assembled output. `operation0..3` are the
  // axis lengths, `steps` is `outer`, and `right_repeat` is `inner`. The
  // host graph planner chooses this mode only when each input is a live arena
  // slot, so all FPN feature assembly remains device-resident.
  if (params.mode == 42u) {
    const uint index = gl_GlobalInvocationID.x * 4u;
    const uint total = params.count;
    const uint outer = params.steps;
    const uint inner = params.right_repeat;
    const uint lengths[4] = uint[4](params.operation0, params.operation1, params.operation2, params.operation3);
    const uint total_axis = lengths[0] + lengths[1] + lengths[2] + lengths[3];
    if (index >= total || outer == 0u || inner == 0u || total_axis == 0u ||
        total != outer * total_axis * inner) return;
    for (uint lane = 0u; lane < 4u && index + lane < total; ++lane) {
      const uint dst = index + lane;
      const uint group = dst / (total_axis * inner);
      const uint local = dst - group * total_axis * inner;
      const uint axis = local / inner;
      const uint within = local - axis * inner;
      uint prefix = 0u;
      if (axis < lengths[0]) d[dst] = a[(group * lengths[0] + axis) * inner + within];
      else if (axis < (prefix = lengths[0] + lengths[1]))
        d[dst] = b[(group * lengths[1] + (axis - lengths[0])) * inner + within];
      else if (axis < (prefix += lengths[2]))
        d[dst] = c[(group * lengths[2] + (axis - lengths[0] - lengths[1])) * inner + within];
      else d[dst] = e[(group * lengths[3] + (axis - prefix)) * inner + within];
    }
    return;
  }
  // Mode 43 is integer-factor asymmetric/floor nearest resize. The PP-OCRv6
  // FPN exporter emits precisely this ONNX form (2x/4x/8x); unlike the
  // Resize+Add fusion it also covers a Resize whose consumer is a later
  // Concat or convolution.
  if (params.mode == 43u) {
    // Generic depthwise dispatch is a packed vec4 grid.  With 256 shader
    // invocations per workgroup, one workgroup covers 1,024 output floats.
    const uint index = gl_GlobalInvocationID.x * 4u;
    const uint batch = gl_GlobalInvocationID.y;
    const uint channels = params.operation0;
    const uint input_h = params.operation1;
    const uint input_w = params.operation2;
    const uint scale_h = params.operation3;
    const uint scale_w = params.steps;
    const uint output_h = input_h * scale_h;
    const uint output_w = input_w * scale_w;
    const uint output_plane = output_h * output_w;
    if (batch >= params.batches || index >= params.count || channels == 0u || input_h == 0u || input_w == 0u ||
        scale_h == 0u || scale_w == 0u) return;
    for (uint lane = 0u; lane < 4u && index + lane < params.count; ++lane) {
      const uint output_index = index + lane;
      const uint channel = output_index / output_plane;
      const uint spatial = output_index - channel * output_plane;
      const uint y = spatial / output_w;
      const uint x = spatial - y * output_w;
      const uint source = (batch * channels + channel) * input_h * input_w +
                          (y / scale_h) * input_w + (x / scale_w);
      d[batch * params.count + output_index] = a[source];
    }
    return;
  }
  // Mode 44 is a graph-local device copy. It supports branch fan-out and
  // non-aliasable terminal outputs without a mapped-memory memcpy.
  if (params.mode == 44u) {
    const uint index = gl_GlobalInvocationID.x * 4u;
    if (index >= params.count) return;
    for (uint lane = 0u; lane < 4u && index + lane < params.count; ++lane)
      d[index + lane] = a[index + lane];
    return;
  }
  // Mode 33 is generic in-place NCHW channel affine. It is the device form
  // of inference BatchNorm after the immutable scale/mean/variance constants
  // have been folded by the graph executor. B/C are compact `[C]` vectors.
  if (params.mode == 33u || params.mode == 45u || params.mode == 66u) {
    const uint index = gl_GlobalInvocationID.x * 4u;
    const uint batch = gl_GlobalInvocationID.y;
    const uint plane = params.right_repeat;
    const uint channels = params.right_per_batch;
    if (batch >= params.batches || index >= params.count || plane == 0u || channels == 0u) return;
    const uint offset = batch * params.count + index;
    for (uint lane = 0u; lane < 4u && index + lane < params.count; ++lane) {
      const uint channel = (index + lane) / plane;
      float value = a[offset + lane] * b[channel] + c[channel];
      if (params.mode == 45u) value *= 1.0 / (1.0 + exp(-value));
      else if (params.mode == 66u) value *= clamp(value / 6.0 + 0.5, 0.0, 1.0);
      a[offset + lane] = value;
    }
    return;
  }
  // Mode 60 copies `count` floats from A to E so Conv.0 can stay resident
  // while later stem layers ping-pong A/D. Mapped UMA vkCmdCopyBuffer was
  // observed to leave a 32x48 Conv.0 plane stale (mid RGB+Conv.012).
  if ((params.mode & 0xffffu) == 60u || (params.mode & 0xffffu) == 61u) {
    const uint index = gl_GlobalInvocationID.x * 4u;
    if (index >= params.count) return;
    const bool d_to_a = (params.mode & 0xffffu) == 61u;
    for (uint lane = 0u; lane < 4u && index + lane < params.count; ++lane) {
      if (d_to_a) a[index + lane] = d[index + lane];
      else e[index + lane] = a[index + lane];
    }
    return;
  }
  // Modes 46/47 fuse packed-RGB bilinear sampling and NCHW normalization for
  // the detector/recognizer front ends. A's byte representation contains
  // native packed RGB input; D is
  // the NCHW result. Mode 46 uses PP-OCR detector BGR/ImageNet affine
  // constants; mode 47 uses recognizer BGR [-1,1] normalization.
  if ((params.mode & 0xffffu) == 46u || (params.mode & 0xffffu) == 47u) {
    const uint index = gl_GlobalInvocationID.x * 4u;
    const uint source_w = params.operation0;
    const uint source_h = params.operation1;
    const uint left = params.operation2;
    const uint top = params.operation3;
    const uint region_w = params.steps;
    const uint region_h = params.right_repeat;
    const uint output_w = params.right_per_batch;
