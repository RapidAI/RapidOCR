        const uint sy = ly * stride;
        const uint sx = lx * stride;
        for (uint ic = 0u; ic < channels; ++ic) {
          const uint p0 = ic * halo_plane + sy * tile_w + sx;
          const uint p1 = p0 + tile_w;
          const uint p2 = p1 + tile_w;
          const float i00 = conv_weights[p0], i01 = conv_weights[p0 + 1u], i02 = conv_weights[p0 + 2u];
          const float i10 = conv_weights[p1], i11 = conv_weights[p1 + 1u], i12 = conv_weights[p1 + 2u];
          const float i20 = conv_weights[p2], i21 = conv_weights[p2 + 1u], i22 = conv_weights[p2 + 2u];
          for (uint q = 0u; q < 4u; ++q) {
            const uint oc = oc0 + q;
            if (oc >= output_channels) break;
            const uint wb = q * channels * 9u + ic * 9u;
            const float w0 = depthwise_weights[wb], w1 = depthwise_weights[wb + 1u], w2 = depthwise_weights[wb + 2u];
            const float w3 = depthwise_weights[wb + 3u], w4 = depthwise_weights[wb + 4u], w5 = depthwise_weights[wb + 5u];
            const float w6 = depthwise_weights[wb + 6u], w7 = depthwise_weights[wb + 7u], w8 = depthwise_weights[wb + 8u];
            const float sum = i00 * w0 + i01 * w1 + i02 * w2 + i10 * w3 + i11 * w4 + i12 * w5 +
                              i20 * w6 + i21 * w7 + i22 * w8;
            if (q == 0u) acc0 += sum;
            else if (q == 1u) acc1 += sum;
            else if (q == 2u) acc2 += sum;
            else acc3 += sum;
          }
        }
      }
    } else {
      if (filters_in_dw || filters_in_cw) barrier();
      // Stage as many input-channel halos as the 4096-wide tile holds so
      // Concat.2 (C=64, s1 18x18) does 12 channels per barrier instead of 64.
      const uint ic_tile = halo_plane == 0u ? 1u : min(channels, 4096u / halo_plane);
      const uint ic_step = ic_tile == 0u ? 1u : ic_tile;
      for (uint ic0 = 0u; ic0 < channels; ic0 += ic_step) {
        const uint n_ic = min(ic_step, channels - ic0);
        const uint packed = n_ic * halo_plane;
        for (uint i = local; i < packed; i += gl_WorkGroupSize.x) {
          const uint ic = i / halo_plane;
          const uint rem = i - ic * halo_plane;
          const uint sy = rem / tile_w;
          const uint sx = rem - sy * tile_w;
          const int gy = origin_y + int(sy);
          const int gx = origin_x + int(sx);
          float v = 0.0;
          if (gy >= 0 && gy < int(input_h) && gx >= 0 && gx < int(input_w))
            v = swap_ad ? d[input_batch_base + (ic0 + ic) * input_plane + uint(gy) * input_w + uint(gx)]
                        : a[input_batch_base + (ic0 + ic) * input_plane + uint(gy) * input_w + uint(gx)];
          conv_spatial_tile[i] = v;
        }
        barrier();
        if (in_bounds) {
          const uint sy = ly * stride;
          const uint sx = lx * stride;
          for (uint ic = 0u; ic < n_ic; ++ic) {
            const uint src_ic = ic0 + ic;
            const uint base = ic * halo_plane + sy * tile_w + sx;
            const uint p0 = base;
            const uint p1 = base + tile_w;
            const uint p2 = p1 + tile_w;
            const float i00 = conv_spatial_tile[p0], i01 = conv_spatial_tile[p0 + 1u], i02 = conv_spatial_tile[p0 + 2u];
            const float i10 = conv_spatial_tile[p1], i11 = conv_spatial_tile[p1 + 1u], i12 = conv_spatial_tile[p1 + 2u];
            const float i20 = conv_spatial_tile[p2], i21 = conv_spatial_tile[p2 + 1u], i22 = conv_spatial_tile[p2 + 2u];
            for (uint q = 0u; q < 4u; ++q) {
              const uint oc = oc0 + q;
              if (oc >= output_channels) break;
              float w0, w1, w2, w3, w4, w5, w6, w7, w8;
              if (filters_in_dw || filters_in_cw) {
                const uint wb = q * channels * 9u + src_ic * 9u;
                if (filters_in_dw) {
                  w0 = depthwise_weights[wb]; w1 = depthwise_weights[wb + 1u]; w2 = depthwise_weights[wb + 2u];
                  w3 = depthwise_weights[wb + 3u]; w4 = depthwise_weights[wb + 4u]; w5 = depthwise_weights[wb + 5u];
                  w6 = depthwise_weights[wb + 6u]; w7 = depthwise_weights[wb + 7u]; w8 = depthwise_weights[wb + 8u];
                } else {
                  w0 = conv_weights[wb]; w1 = conv_weights[wb + 1u]; w2 = conv_weights[wb + 2u];
                  w3 = conv_weights[wb + 3u]; w4 = conv_weights[wb + 4u]; w5 = conv_weights[wb + 5u];
                  w6 = conv_weights[wb + 6u]; w7 = conv_weights[wb + 7u]; w8 = conv_weights[wb + 8u];
                }
              } else {
                const uint wb = oc * channels * 9u + src_ic * 9u;
                w0 = b[wb]; w1 = b[wb + 1u]; w2 = b[wb + 2u];
                w3 = b[wb + 3u]; w4 = b[wb + 4u]; w5 = b[wb + 5u];
                w6 = b[wb + 6u]; w7 = b[wb + 7u]; w8 = b[wb + 8u];
              }
              const float sum = i00 * w0 + i01 * w1 + i02 * w2 + i10 * w3 + i11 * w4 + i12 * w5 +
                                i20 * w6 + i21 * w7 + i22 * w8;
              if (q == 0u) acc0 += sum;
              else if (q == 1u) acc1 += sum;
              else if (q == 2u) acc2 += sum;
              else acc3 += sum;
            }
          }
        }
        barrier();
      }
    }
    if (in_bounds) {
      const uint out_base = batch * params.count + oy * output_w + ox;
      const bool relu = (params.mode & 0x7fffu) == 51u;
      const float o0 = relu ? max(acc0, 0.0) : acc0;
      const float o1 = relu ? max(acc1, 0.0) : acc1;
      const float o2 = relu ? max(acc2, 0.0) : acc2;
      const float o3 = relu ? max(acc3, 0.0) : acc3;
      if (swap_ad) {
        a[out_base + oc0 * output_plane] = o0;
        if (oc0 + 1u < output_channels) a[out_base + (oc0 + 1u) * output_plane] = o1;
        if (oc0 + 2u < output_channels) a[out_base + (oc0 + 2u) * output_plane] = o2;
        if (oc0 + 3u < output_channels) a[out_base + (oc0 + 3u) * output_plane] = o3;
      } else {
        d[out_base + oc0 * output_plane] = o0;
        if (oc0 + 1u < output_channels) d[out_base + (oc0 + 1u) * output_plane] = o1;
        if (oc0 + 2u < output_channels) d[out_base + (oc0 + 2u) * output_plane] = o2;
        if (oc0 + 3u < output_channels) d[out_base + (oc0 + 3u) * output_plane] = o3;
      }
    }
    return;
  }
  // Modes 14/15/26/27/28 are the detector's ordinary ungrouped convolution,
  // with the latter modes respectively applying ReLU, exact Swish, Sigmoid,
  // or HardSwish before the one host readback. Each
  // invocation owns four adjacent positions of one output channel where
  // possible; every output reduction retains the ONNX FP32 accumulation
  // order.  Inputs/weights/biases are respectively [N,C,H,W], [M,C,KH,KW]
  // and [M].
  if ((params.mode & 0x7fffu) == 14u || (params.mode & 0x7fffu) == 15u ||
      (params.mode & 0x7fffu) == 26u || (params.mode & 0x7fffu) == 27u ||
      (params.mode & 0x7fffu) == 28u) {
    const uint batch = gl_GlobalInvocationID.y;
    if (batch >= params.batches) return;
    const bool swap_ad = (params.mode & 0x8000u) != 0u;
    const uint channels = params.operation0;
    const uint input_h = params.operation1;
    const uint input_w = params.operation2;
    const uint output_h = params.operation3;
    const uint output_w = params.steps;
    const uint kernel_h = params.right_repeat;
    const uint kernel_w = params.right_per_batch;
    const uint stride = params.right_batch_stride;
    const uint pad_top = (params.mode >> 16u) & 0xffu;
    const uint pad_left = (params.mode >> 24u) & 0xffu;
    if (channels == 0u || input_h == 0u || input_w == 0u || output_h == 0u ||
        output_w == 0u || kernel_h == 0u || kernel_w == 0u || stride == 0u) return;
    const uint input_plane = input_h * input_w;
    const uint output_plane = output_h * output_w;
    const uint kernel_plane = kernel_h * kernel_w;
    const uint output_channels = params.count / output_plane;
    const uint weights_per_channel = channels * kernel_plane;
    // The graph dispatcher may use several workgroups per output channel.
    // In that form gl_WorkGroupID.x contains both the channel and spatial-tile
    // index; keep this threshold synchronized with RunArenaConv2d().
    const uint outputs_per_workgroup = gl_WorkGroupSize.x * 4u;
    const uint groups_per_channel =
        (output_plane + outputs_per_workgroup - 1u) / outputs_per_workgroup;
    // Keep all workgroup lanes on the same barrier path.  This fast path uses
    // one workgroup per (batch, output-channel, spatial tile), so its compact
    // [C,KH,KW] weight row is shared by up to 1,024 output values.
    // This must exactly mirror the host dispatch policy in RunArenaConv2d().
    // Small output planes use the generic vec4 dispatch; interpreting those
    // workgroups as channel tiles corrupts compact SE gate convolutions.
    if (weights_per_channel <= 4096u && output_plane >= 2048u &&
        stride == 1u && groups_per_channel != 0u) {
      const uint local = gl_LocalInvocationID.x;
      // 3x3 filters of at most 113 input channels fit four output rows in
      // the 4096-wide cache. One input tap then feeds four FMAs, which is
      // the FPN Concat+Conv (64->16) arithmetic-intensity problem.
      const bool tile4oc = kernel_h == 3u && kernel_w == 3u &&
          (weights_per_channel * 4u <= 4096u);
      const uint oc_tile = tile4oc ? 4u : 1u;
      const uint oc_block = gl_WorkGroupID.x / groups_per_channel;
      const uint output_channel = oc_block * oc_tile;
      const bool valid_channel = output_channel < output_channels;
      const uint cached = weights_per_channel * oc_tile;
      for (uint weight = local; weight < cached; weight += gl_WorkGroupSize.x) {
        const uint q = weight / weights_per_channel;
        const uint rem = weight - q * weights_per_channel;
        const uint oc = output_channel + q;
        conv_weights[weight] = (oc < output_channels) ? b[oc * weights_per_channel + rem] : 0.0;
      }
      barrier();
      if (!valid_channel) return;
      const uint spatial_start = (gl_WorkGroupID.x - oc_block * groups_per_channel) *
          outputs_per_workgroup + local * 4u;
      const uint lane_count = 4u;
      const uint input_batch_base = batch * channels * input_plane;
      const bool conv3x3_same = kernel_h == 3u && kernel_w == 3u && stride == 1u &&
          pad_top == 1u && pad_left == 1u;
      const bool conv3x3_s2 = kernel_h == 3u && kernel_w == 3u && stride == 2u &&
          pad_top == 1u && pad_left == 1u;
      for (uint lane = 0u; lane < lane_count && spatial_start + lane < output_plane; ++lane) {
        const uint spatial = spatial_start + lane;
        const uint output_y = spatial / output_w;
        const uint output_x = spatial % output_w;
        float acc0 = c[output_channel];
        float acc1 = (oc_tile > 1u && output_channel + 1u < output_channels) ? c[output_channel + 1u] : 0.0;
        float acc2 = (oc_tile > 1u && output_channel + 2u < output_channels) ? c[output_channel + 2u] : 0.0;
        float acc3 = (oc_tile > 1u && output_channel + 3u < output_channels) ? c[output_channel + 3u] : 0.0;
        const int input_y = int(output_y * stride) - int(pad_top);
        const int input_x = int(output_x * stride) - int(pad_left);
        const bool interior = conv3x3_same && output_y > 0u && output_x > 0u &&
            output_y + 1u < input_h && output_x + 1u < input_w;
        const bool interior_s2 = conv3x3_s2 && output_y > 0u && output_x > 0u &&
            (output_y * 2u + 1u) < input_h && (output_x * 2u + 1u) < input_w;
        if (interior || interior_s2) {
          const uint row0 = interior
              ? (output_y - 1u) * input_w + (output_x - 1u)
              : (output_y * 2u - 1u) * input_w + (output_x * 2u - 1u);
          for (uint channel = 0u; channel < channels; ++channel) {
            const uint ib = input_batch_base + channel * input_plane + row0;
            const float i00 = swap_ad ? d[ib] : a[ib];
            const float i01 = swap_ad ? d[ib + 1u] : a[ib + 1u];
            const float i02 = swap_ad ? d[ib + 2u] : a[ib + 2u];
            const float i10 = swap_ad ? d[ib + input_w] : a[ib + input_w];
            const float i11 = swap_ad ? d[ib + input_w + 1u] : a[ib + input_w + 1u];
            const float i12 = swap_ad ? d[ib + input_w + 2u] : a[ib + input_w + 2u];
            const float i20 = swap_ad ? d[ib + 2u * input_w] : a[ib + 2u * input_w];
            const float i21 = swap_ad ? d[ib + 2u * input_w + 1u] : a[ib + 2u * input_w + 1u];
            const float i22 = swap_ad ? d[ib + 2u * input_w + 2u] : a[ib + 2u * input_w + 2u];
            for (uint q = 0u; q < oc_tile; ++q) {
              if (output_channel + q >= output_channels) break;
              const uint wo = q * weights_per_channel + channel * 9u;
              const float sum = i00 * conv_weights[wo] + i01 * conv_weights[wo + 1u] +
                                i02 * conv_weights[wo + 2u] + i10 * conv_weights[wo + 3u] +
                                i11 * conv_weights[wo + 4u] + i12 * conv_weights[wo + 5u] +
                                i20 * conv_weights[wo + 6u] + i21 * conv_weights[wo + 7u] +
                                i22 * conv_weights[wo + 8u];
              if (q == 0u) acc0 += sum;
              else if (q == 1u) acc1 += sum;
              else if (q == 2u) acc2 += sum;
              else acc3 += sum;
            }
          }
        } else {
          for (uint channel = 0u; channel < channels; ++channel) {
            const uint input_channel_base = input_batch_base + channel * input_plane;
            for (uint ky = 0u; ky < kernel_h; ++ky) {
              const int y = input_y + int(ky);
              if (y < 0 || y >= int(input_h)) continue;
              for (uint kx = 0u; kx < kernel_w; ++kx) {
                const int x = input_x + int(kx);
                if (x >= 0 && x < int(input_w)) {
                  const float srcv = swap_ad
                      ? d[input_channel_base + uint(y) * input_w + uint(x)]
                      : a[input_channel_base + uint(y) * input_w + uint(x)];
                  const uint ko = channel * kernel_plane + ky * kernel_w + kx;
                  acc0 += srcv * conv_weights[ko];
                  if (oc_tile > 1u) {
                    acc1 += srcv * conv_weights[weights_per_channel + ko];
                    acc2 += srcv * conv_weights[2u * weights_per_channel + ko];
                    acc3 += srcv * conv_weights[3u * weights_per_channel + ko];
                  }
                }
              }
            }
          }
        }
        const bool relu = (params.mode & 0x7fffu) == 15u;
        const bool swish = (params.mode & 0x7fffu) == 26u;
        const bool sigmoid = (params.mode & 0x7fffu) == 27u;
        const bool hswish = (params.mode & 0x7fffu) == 28u;
        const uint out_base = batch * params.count + spatial;
        const uint nch = output_channels - output_channel;
        const uint emit = oc_tile < nch ? oc_tile : nch;
        for (uint q = 0u; q < emit; ++q) {
          float value = q == 0u ? acc0 : (q == 1u ? acc1 : (q == 2u ? acc2 : acc3));
          if (relu) value = max(value, 0.0);
          else if (swish) value *= 1.0 / (1.0 + exp(-value));
          else if (sigmoid) value = 1.0 / (1.0 + exp(-value));
          else if (hswish) value *= clamp(value / 6.0 + 0.5, 0.0, 1.0);
          if (swap_ad) a[out_base + (output_channel + q) * output_plane] = value;
          else d[out_base + (output_channel + q) * output_plane] = value;
        }
      }
      return;
    }
    const uint index = gl_GlobalInvocationID.x * 4u;
    if (index >= params.count) return;
    for (uint lane = 0u; lane < 4u && index + lane < params.count; ++lane) {
      const uint output_index = index + lane;
      const uint output_channel = output_index / output_plane;
      const uint spatial = output_index % output_plane;
      const uint output_y = spatial / output_w;
      const uint output_x = spatial % output_w;
      float value = c[output_channel];
      const int input_y = int(output_y * stride) - int(pad_top);
      const int input_x = int(output_x * stride) - int(pad_left);
      const uint weight_channel_base = output_channel * channels * kernel_plane;
      const uint input_batch_base = batch * channels * input_plane;
      for (uint channel = 0u; channel < channels; ++channel) {
        const uint input_channel_base = input_batch_base + channel * input_plane;
        const uint weight_base = weight_channel_base + channel * kernel_plane;
        for (uint ky = 0u; ky < kernel_h; ++ky) {
          const int y = input_y + int(ky);
          if (y < 0 || y >= int(input_h)) continue;
          for (uint kx = 0u; kx < kernel_w; ++kx) {
            const int x = input_x + int(kx);
            if (x >= 0 && x < int(input_w)) {
              value += (swap_ad
                  ? d[input_channel_base + uint(y) * input_w + uint(x)]
                  : a[input_channel_base + uint(y) * input_w + uint(x)]) *
                       b[weight_base + ky * kernel_w + kx];
            }
          }
        }
      }
      if ((params.mode & 0x7fffu) == 15u) value = max(value, 0.0);
      else if ((params.mode & 0x7fffu) == 26u) value *= 1.0 / (1.0 + exp(-value));
      else if ((params.mode & 0x7fffu) == 27u) value = 1.0 / (1.0 + exp(-value));
      else if ((params.mode & 0x7fffu) == 28u) value *= clamp(value / 6.0 + 0.5, 0.0, 1.0);
      if (swap_ad) a[batch * params.count + output_index] = value;
      else d[batch * params.count + output_index] = value;
    }
    return;
  }
  // Mode 56 is the detector stem tail: 3x3 stride-2 Conv(+ReLU) over
  // Concat(MaxPool(E), A). D holds the already-pooled Conv.0 map, A holds
  // Conv.2, E receives the stem so the host reads one compact activation.
  if ((params.mode & 0xffffu) == 56u) {
    const uint batch = gl_GlobalInvocationID.y;
    if (batch >= params.batches) return;
    const uint oc0 = params.operation0;
    const uint oc2 = params.operation1;
    const uint input_h = params.operation2;
    const uint input_w = params.operation3;
    const uint output_h = params.steps;
    const uint output_w = params.right_repeat;
    const uint param_weight_base = params.right_per_batch;
    const uint param_bias_base = params.right_batch_stride;
    const uint pad_top = (params.mode >> 16u) & 0xffu;
    const uint pad_left = (params.mode >> 24u) & 0xffu;
    const uint channels = oc0 + oc2;
    if (oc0 == 0u || oc2 == 0u || channels == 0u || input_h == 0u || input_w == 0u ||
        output_h == 0u || output_w == 0u) return;
    const uint input_plane = input_h * input_w;
    const uint output_plane = output_h * output_w;
    const uint output_channels = params.count / output_plane;
    const uint weights_per_channel = channels * 9u;
    const uint outputs_per_workgroup = gl_WorkGroupSize.x * 4u;
    const uint groups_per_channel =
        (output_plane + outputs_per_workgroup - 1u) / outputs_per_workgroup;
    if (weights_per_channel > 4096u || output_plane < 256u || groups_per_channel == 0u) {
      const uint index = gl_GlobalInvocationID.x * 4u;
      if (index >= params.count) return;
      for (uint lane = 0u; lane < 4u && index + lane < params.count; ++lane) {
        const uint output_index = index + lane;
        const uint output_channel = output_index / output_plane;
        const uint spatial = output_index - output_channel * output_plane;
        const uint output_y = spatial / output_w;
        const uint output_x = spatial - output_y * output_w;
        float value = c[param_bias_base + output_channel];
        const int input_y = int(output_y * 2u) - int(pad_top);
        const int input_x = int(output_x * 2u) - int(pad_left);
        const uint weight_channel_base = output_channel * weights_per_channel;
        for (uint channel = 0u; channel < channels; ++channel) {
          const bool from_d = channel < oc0;
          const uint src_ch = from_d ? channel : channel - oc0;
          const uint input_channel_base = src_ch * input_plane;
          const uint weight_base = weight_channel_base + channel * 9u;
          for (uint ky = 0u; ky < 3u; ++ky) {
            const int y = input_y + int(ky);
            if (y < 0 || y >= int(input_h)) continue;
            for (uint kx = 0u; kx < 3u; ++kx) {
              const int x = input_x + int(kx);
              if (x >= 0 && x < int(input_w)) {
                const float srcv = from_d
                    ? d[input_channel_base + uint(y) * input_w + uint(x)]
                    : a[input_channel_base + uint(y) * input_w + uint(x)];
                value += srcv * b[param_weight_base + weight_base + ky * 3u + kx];
              }
            }
          }
        }
        e[batch * params.count + output_index] = max(value, 0.0);
      }
      return;
    }
    const uint local = gl_LocalInvocationID.x;
    const bool tile4oc = weights_per_channel * 4u <= 4096u;
    const uint oc_tile = tile4oc ? 4u : 1u;
    const uint oc_block = gl_WorkGroupID.x / groups_per_channel;
    const uint output_channel = oc_block * oc_tile;
    const bool valid_channel = output_channel < output_channels;
    const uint cached = weights_per_channel * oc_tile;
    for (uint weight = local; weight < cached; weight += gl_WorkGroupSize.x) {
      const uint q = weight / weights_per_channel;
      const uint rem = weight - q * weights_per_channel;
      const uint oc = output_channel + q;
      conv_weights[weight] = (oc < output_channels)
          ? b[param_weight_base + oc * weights_per_channel + rem] : 0.0;
    }
    barrier();
    if (!valid_channel) return;
    const uint spatial_start = (gl_WorkGroupID.x - oc_block * groups_per_channel) *
        outputs_per_workgroup + local * 4u;
    for (uint lane = 0u; lane < 4u && spatial_start + lane < output_plane; ++lane) {
      const uint spatial = spatial_start + lane;
      const uint output_y = spatial / output_w;
      const uint output_x = spatial - output_y * output_w;
      float acc0 = c[param_bias_base + output_channel];
      float acc1 = (oc_tile > 1u && output_channel + 1u < output_channels)
          ? c[param_bias_base + output_channel + 1u] : 0.0;
      float acc2 = (oc_tile > 1u && output_channel + 2u < output_channels)
          ? c[param_bias_base + output_channel + 2u] : 0.0;
      float acc3 = (oc_tile > 1u && output_channel + 3u < output_channels)
          ? c[param_bias_base + output_channel + 3u] : 0.0;
      const int input_y = int(output_y * 2u) - int(pad_top);
      const int input_x = int(output_x * 2u) - int(pad_left);
      const bool interior = output_y > 0u && output_x > 0u &&
          (output_y * 2u + 1u) < input_h && (output_x * 2u + 1u) < input_w;
      for (uint channel = 0u; channel < channels; ++channel) {
        const bool from_d = channel < oc0;
        const uint src_ch = from_d ? channel : channel - oc0;
        const uint input_channel_base = src_ch * input_plane;
        if (interior) {
          const uint row0 = (output_y * 2u - 1u) * input_w + (output_x * 2u - 1u);
          const uint ib = input_channel_base + row0;
          const float i00 = from_d ? d[ib] : a[ib];
          const float i01 = from_d ? d[ib + 1u] : a[ib + 1u];
          const float i02 = from_d ? d[ib + 2u] : a[ib + 2u];
          const float i10 = from_d ? d[ib + input_w] : a[ib + input_w];
          const float i11 = from_d ? d[ib + input_w + 1u] : a[ib + input_w + 1u];
          const float i12 = from_d ? d[ib + input_w + 2u] : a[ib + input_w + 2u];
          const float i20 = from_d ? d[ib + 2u * input_w] : a[ib + 2u * input_w];
          const float i21 = from_d ? d[ib + 2u * input_w + 1u] : a[ib + 2u * input_w + 1u];
          const float i22 = from_d ? d[ib + 2u * input_w + 2u] : a[ib + 2u * input_w + 2u];
          for (uint q = 0u; q < oc_tile; ++q) {
            if (output_channel + q >= output_channels) break;
            const uint wo = q * weights_per_channel + channel * 9u;
            const float sum = i00 * conv_weights[wo] + i01 * conv_weights[wo + 1u] +
                              i02 * conv_weights[wo + 2u] + i10 * conv_weights[wo + 3u] +
                              i11 * conv_weights[wo + 4u] + i12 * conv_weights[wo + 5u] +
                              i20 * conv_weights[wo + 6u] + i21 * conv_weights[wo + 7u] +
                              i22 * conv_weights[wo + 8u];
            if (q == 0u) acc0 += sum;
            else if (q == 1u) acc1 += sum;
            else if (q == 2u) acc2 += sum;
            else acc3 += sum;
          }
        } else {
          for (uint ky = 0u; ky < 3u; ++ky) {
            const int y = input_y + int(ky);
            if (y < 0 || y >= int(input_h)) continue;
            for (uint kx = 0u; kx < 3u; ++kx) {
              const int x = input_x + int(kx);
              if (x >= 0 && x < int(input_w)) {
                const float srcv = from_d
                    ? d[input_channel_base + uint(y) * input_w + uint(x)]
                    : a[input_channel_base + uint(y) * input_w + uint(x)];
                const uint ko = channel * 9u + ky * 3u + kx;
                acc0 += srcv * conv_weights[ko];
                if (oc_tile > 1u) {
                  acc1 += srcv * conv_weights[weights_per_channel + ko];
                  acc2 += srcv * conv_weights[2u * weights_per_channel + ko];
                  acc3 += srcv * conv_weights[3u * weights_per_channel + ko];
                }
              }
            }
          }
        }
      }
      const uint nch = output_channels - output_channel;
      const uint emit = oc_tile < nch ? oc_tile : nch;
      for (uint q = 0u; q < emit; ++q) {
        float value = q == 0u ? acc0 : (q == 1u ? acc1 : (q == 2u ? acc2 : acc3));
        e[batch * params.count + spatial + (output_channel + q) * output_plane] = max(value, 0.0);
      }
    }
    return;
  }
  // Mode 16 is the detector FPN's 2x2 stride-two transposed convolution.
  // With zero padding/output padding its output tiles never overlap: every
  // (oy,ox) maps to one input (oy/2,ox/2) and one weight tap.  This keeps a
  // batched upsample/projection in one dispatch without materialising an
  // expanded input tensor.
  if ((params.mode & 0xffffu) == 16u) {
    const uint batch = gl_GlobalInvocationID.y;
    const uint index = gl_GlobalInvocationID.x * 4u;
    if (batch >= params.batches || index >= params.count) return;
    const uint input_channels = params.operation0;
    const uint output_channels = params.operation1;
    const uint input_h = params.operation2;
    const uint input_w = params.operation3;
    if (input_channels == 0u || output_channels == 0u || input_h == 0u || input_w == 0u) return;
    const uint input_plane = input_h * input_w;
    const uint output_w = input_w * 2u;
    const uint output_plane = input_plane * 4u;
    for (uint lane = 0u; lane < 4u && index + lane < params.count; ++lane) {
      const uint output_index = index + lane;
      const uint output_channel = output_index / output_plane;
      const uint spatial = output_index % output_plane;
      const uint output_y = spatial / output_w;
      const uint output_x = spatial % output_w;
      const uint input_index = (output_y >> 1u) * input_w + (output_x >> 1u);
      const uint tap = ((output_y & 1u) << 1u) | (output_x & 1u);
      float value = c[output_channel];
      const uint input_base = batch * input_channels * input_plane + input_index;
      for (uint input_channel = 0u; input_channel < input_channels; ++input_channel) {
        value += a[input_base + input_channel * input_plane] *
                 b[((input_channel * output_channels + output_channel) << 2u) + tap];
      }
      const uint act = params.mode >> 16u;
      if (act == 1u) value = max(value, 0.0);
      else if (act == 2u) value = 1.0 / (1.0 + exp(-value));
      d[batch * params.count + output_index] = value;
    }
    return;
  }
  // Mode 17 is the tiled variant of mode 16.  A workgroup owns one output
  // channel and 1,024 output pixels, so its compact [Cin,2,2] filter row is
  // staged once in the existing ordinary-convolution shared array.  The FPN
  // transpose geometry has no cross-pixel accumulation, therefore this keeps
  // the identical input-channel FP32 reduction order while avoiding a global
  // weight fetch for every output pixel.
  if ((params.mode & 0xffffu) == 17u) {
    const uint batch = gl_WorkGroupID.y;
    const uint input_channels = params.operation0;
    const uint output_channels = params.operation1;
    const uint input_h = params.operation2;
    const uint input_w = params.operation3;
    const uint output_w = input_w * 2u;
    const uint output_plane = input_h * input_w * 4u;
    const uint groups_per_channel = (output_plane + 1023u) / 1024u;
    const uint output_channel = gl_WorkGroupID.x / groups_per_channel;
    const bool valid = batch < params.batches && output_channel < output_channels &&
                       input_channels > 0u && input_h > 0u && input_w > 0u;
    const uint local = gl_LocalInvocationID.x;
    const uint weights_per_channel = input_channels * 4u;
    // All workgroup lanes take the same barrier path, including malformed
    // out-of-range groups.  C++ selects this mode only up to the 4,096-float
    // shared-array capacity.
    for (uint weight = local; weight < weights_per_channel; weight += gl_WorkGroupSize.x) {
      // ONNX ConvTranspose weights are [Cin,Cout,2,2], unlike Conv's
      // output-channel-major layout. Repack just this compact filter row
      // while staging it, then the reduction can use contiguous shared loads.
      const uint input_channel = weight >> 2u;
      const uint tap = weight & 3u;
      conv_weights[weight] = valid
          ? b[((input_channel * output_channels + output_channel) << 2u) + tap]
          : 0.0;
    }
    barrier();
    if (!valid) return;
    const uint spatial_start = (gl_WorkGroupID.x - output_channel * groups_per_channel) *
        1024u + local * 4u;
    const uint input_plane = input_h * input_w;
    const uint input_batch_base = batch * input_channels * input_plane;
    for (uint lane = 0u; lane < 4u && spatial_start + lane < output_plane; ++lane) {
      const uint spatial = spatial_start + lane;
      const uint output_y = spatial / output_w;
      const uint output_x = spatial % output_w;
      const uint input_index = (output_y >> 1u) * input_w + (output_x >> 1u);
      const uint tap = ((output_y & 1u) << 1u) | (output_x & 1u);
      float value = c[output_channel];
      for (uint input_channel = 0u; input_channel < input_channels; ++input_channel) {
        value += a[input_batch_base + input_channel * input_plane + input_index] *
                 conv_weights[(input_channel << 2u) + tap];
      }
      const uint act = params.mode >> 16u;
      if (act == 1u) value = max(value, 0.0);
      else if (act == 2u) value = 1.0 / (1.0 + exp(-value));
      d[batch * params.count + output_channel * output_plane + spatial] = value;
    }
    return;
  }
  // Mode 67 chains two 2x2 stride-2 ConvTransposes: Relu on the exclusive
  // 2x mid patch, Sigmoid on the 4x output. A is [N,Cin,H,W], B is W0
  // [Cin,Mid,2,2], C is b0[Mid], E is W1[Mid,Cout,2,2] then b1[Cout], D is
  // [N,Cout,4H,4W]. operation0..3 are Cin/Mid/H/W, steps is Cout.
  if ((params.mode & 0xffffu) == 67u) {
    const uint batch = gl_GlobalInvocationID.y;
    const uint index = gl_GlobalInvocationID.x * 4u;
    if (batch >= params.batches || index >= params.count) return;
    const uint input_channels = params.operation0;
    const uint mid_channels = params.operation1;
    const uint input_h = params.operation2;
    const uint input_w = params.operation3;
    const uint output_channels = params.steps;
    if (input_channels == 0u || mid_channels == 0u || output_channels == 0u ||
        input_h == 0u || input_w == 0u) return;
    const uint input_plane = input_h * input_w;
    const uint output_w = input_w * 4u;
    const uint output_plane = input_plane * 16u;
    const uint w1_floats = mid_channels * output_channels * 4u;
    for (uint lane = 0u; lane < 4u && index + lane < params.count; ++lane) {
      const uint output_index = index + lane;
      const uint output_channel = output_index / output_plane;
      const uint spatial = output_index % output_plane;
      const uint output_y = spatial / output_w;
      const uint output_x = spatial % output_w;
      const uint input_y = output_y >> 2u;
      const uint input_x = output_x >> 2u;
      const uint ky = (output_y >> 1u) & 1u;
      const uint kx = (output_x >> 1u) & 1u;
      const uint ly = output_y & 1u;
      const uint lx = output_x & 1u;
      const uint mid_tap = (ky << 1u) | kx;
      const uint out_tap = (ly << 1u) | lx;
      const uint input_index = input_y * input_w + input_x;
      const uint input_base = batch * input_channels * input_plane + input_index;
      float acc = e[w1_floats + output_channel];
      for (uint mid = 0u; mid < mid_channels; ++mid) {
        float cell = c[mid];
        for (uint input_channel = 0u; input_channel < input_channels; ++input_channel) {
          cell += a[input_base + input_channel * input_plane] *
                  b[((input_channel * mid_channels + mid) << 2u) + mid_tap];
        }
        cell = max(cell, 0.0);
        acc += cell * e[((mid * output_channels + output_channel) << 2u) + out_tap];
      }
      d[batch * params.count + output_index] = 1.0 / (1.0 + exp(-acc));
    }
    return;
  }
  // Mode 18 is detector FPN's `Resize(nearest, 2x) + Add` local fusion.
  // Binding A holds [N,C,H,W] source, binding E the equal-sized residual,
  // and binding D receives [N,C,2H,2W].  Keep the expanded activation on the
  // device until the fused addition is complete; X still covers four output
  // values per invocation and Y is the true NCHW batch axis.
  if ((params.mode & 0xffffu) == 18u) {
    const uint batch = gl_GlobalInvocationID.y;
    const uint index = gl_GlobalInvocationID.x * 4u;
    const uint input_h = params.right_repeat;
    const uint input_w = params.right_per_batch;
    const uint channels = params.right_batch_stride;
    if (batch >= params.batches || index >= params.count || input_h == 0u ||
        input_w == 0u || channels == 0u) return;
    const uint input_plane = input_h * input_w;
    const uint output_w = input_w * 2u;
    const uint output_plane = input_plane * 4u;
    for (uint lane = 0u; lane < 4u && index + lane < params.count; ++lane) {
      const uint output_index = index + lane;
      const uint channel = output_index / output_plane;
      const uint spatial = output_index % output_plane;
      const uint output_y = spatial / output_w;
      const uint output_x = spatial % output_w;
      const uint input_index = (output_y >> 1u) * input_w + (output_x >> 1u);
      const uint source_offset = (batch * channels + channel) * input_plane + input_index;
      const uint output_offset = batch * params.count + output_index;
      d[output_offset] = a[source_offset] + e[output_offset];
    }
    return;
  }
  // Mode 31 consumes the device-resident output of modes 16/17 and adds the
  // equal-sized FPN lateral residual from E.  Its source ConvTranspose and
  // this Add are deliberately separate dispatches because the transpose
  // kernel's optional shared-filter tile needs a workgroup barrier; keeping
  // D on device still removes one full host round trip and one CPU traversal.
  if ((params.mode & 0xffffu) == 31u) {
    const uint batch = gl_GlobalInvocationID.y;
    const uint index = gl_GlobalInvocationID.x * 4u;
    if (batch >= params.batches || index >= params.count) return;
    for (uint lane = 0u; lane < 4u && index + lane < params.count; ++lane) {
      const uint output_offset = batch * params.count + index + lane;
      a[output_offset] = d[output_offset] + e[output_offset];
    }
    return;
  }
  // Modes 19/23 are the compact row-major GEMM fallback used by recognizer
  // projections and the final CTC logits head. Mode 23 adds the recognizer
  // MLP's exact Swish writeback.
  // before the result leaves the device. One invocation computes four
  // contiguous output columns for a row, which keeps B's [K,columns] loads
  // contiguous and reuses the same A value across all four accumulators.
  // Binding C is an optional column bias; operation3 says whether it is
  // present.
  if ((params.mode & 0xffffu) == 19u || (params.mode & 0xffffu) == 23u) {
    const uint index = gl_GlobalInvocationID.x * 4u;
    const uint rows = params.operation0;
    const uint depth = params.operation1;
    const uint columns = params.operation2;
    if (index >= params.count || rows == 0u || depth == 0u || columns == 0u) return;
    for (uint lane = 0u; lane < 4u && index + lane < params.count; ++lane) {
      const uint output_index = index + lane;
      const uint row = output_index / columns;
      const uint column = output_index - row * columns;
      float value = params.operation3 != 0u ? c[column] : 0.0;
      const uint a_lda = params.right_repeat == 0u ? depth : params.right_repeat;
      for (uint k = 0u; k < depth; ++k) {
        const float left = params.right_repeat == 0u ? a[row * depth + k] : a[k * a_lda + row];
        value += left * b[k * columns + column];
      }
      if ((params.mode & 0xffffu) == 23u) value *= 1.0 / (1.0 + exp(-value));
      d[output_index] = value;
    }
    return;
  }
  // Modes 24/25 are the batch-oriented GEMM paths. A 256-lane workgroup owns
  // an 8-row by 128-column tile (each lane writes four adjacent columns). It
  // stages an 8x16 A tile and 16x128 B tile in the existing shared array,
  // sharing each B value across eight rows. K tiles are consumed strictly in
  // ascending order, preserving the CPU GEMM reduction order. Mode 25 folds
  // the recognizer MLP's exact Swish into the final write, avoiding the older
  // generic-GEMM fallback for a real flattened crop batch.
  if ((params.mode & 0xffffu) == 24u || (params.mode & 0xffffu) == 25u) {
    const uint rows = params.operation0;
    const uint depth = params.operation1;
    const uint columns = params.operation2;
    const uint local = gl_LocalInvocationID.x;
    const uint tile_row = gl_WorkGroupID.y * 8u;
    const uint row = tile_row + local / 32u;
    const uint column = gl_WorkGroupID.x * 128u + (local % 32u) * 4u;
    vec4 value = vec4(0.0);
    if (row < rows && column < columns && params.operation3 != 0u) {
      value = vec4(c[column], column + 1u < columns ? c[column + 1u] : 0.0,
                   column + 2u < columns ? c[column + 2u] : 0.0,
                   column + 3u < columns ? c[column + 3u] : 0.0);
    }
    const uint a_lda = params.right_repeat == 0u ? depth : params.right_repeat;
    for (uint k0 = 0u; k0 < depth; k0 += 16u) {
      for (uint index = local; index < 128u; index += gl_WorkGroupSize.x) {
        const uint r = index / 16u;
        const uint k = index % 16u;
        const uint rr = tile_row + r;
        const uint kk = k0 + k;
        pointwise_weights[2048u + index] = rr < rows && kk < depth
            ? (params.right_repeat == 0u ? a[rr * depth + kk] : a[kk * a_lda + rr]) : 0.0;
      }
      for (uint index = local; index < 2048u; index += gl_WorkGroupSize.x) {
        const uint k = index / 128u;
        const uint col = index % 128u;
        const uint global_column = gl_WorkGroupID.x * 128u + col;
        pointwise_weights[index] = k0 + k < depth && global_column < columns
            ? b[(k0 + k) * columns + global_column] : 0.0;
      }
      barrier();
      const uint row_in_tile = local / 32u;
      const uint column_in_tile = (local % 32u) * 4u;
      if (k0 + 16u <= depth) {
        for (uint k = 0u; k < 16u; ++k) {
          const float left = pointwise_weights[2048u + row_in_tile * 16u + k];
          const uint right = k * 128u + column_in_tile;
          value += left * vec4(pointwise_weights[right], pointwise_weights[right + 1u],
                               pointwise_weights[right + 2u], pointwise_weights[right + 3u]);
        }
      } else {
        for (uint k = 0u; k0 + k < depth; ++k) {
          const float left = pointwise_weights[2048u + row_in_tile * 16u + k];
          const uint right = k * 128u + column_in_tile;
          value += left * vec4(pointwise_weights[right], pointwise_weights[right + 1u],
                               pointwise_weights[right + 2u], pointwise_weights[right + 3u]);
        }
      }
      barrier();
    }
    if (row < rows && column < columns) {
      if ((params.mode & 0xffffu) == 25u) {
        value *= 1.0 / (vec4(1.0) + exp(-value));
      }
      const uint output_offset = row * columns + column;
      d[output_offset] = value.x;
      if (column + 1u < columns) d[output_offset + 1u] = value.y;
      if (column + 2u < columns) d[output_offset + 2u] = value.z;
      if (column + 3u < columns) d[output_offset + 3u] = value.w;
    }
    return;
  }
  // Tiled pointwise Conv fast path.  Unlike the generic contiguous-output
  // mapping below, a workgroup here owns four complete output planes over one
  // 256-element spatial tile.  That makes the immutable weight row a shared
  // resource instead of streaming it once for every output vec4.
  if ((params.mode == 3u || params.mode == 4u || params.mode == 5u ||
       params.mode == 6u || params.mode == 7u || params.mode == 9u ||
       params.mode == 10u || params.mode == 11u || params.mode == 12u ||
       params.mode == 29u || params.mode == 30u || params.mode == 55u) &&
      params.right_per_batch <= 1024u) {
    const uint channels_per_group = 4u;
    const uint lanes_per_channel = gl_WorkGroupSize.x / channels_per_group;
    const uint spatial_per_group = lanes_per_channel * 4u;
    const uint groups_per_channel =
        (params.right_repeat + spatial_per_group - 1u) / spatial_per_group;
    const uint channel_block = gl_WorkGroupID.x / groups_per_channel;
    const uint spatial_block = gl_WorkGroupID.x - channel_block * groups_per_channel;
    const uint first_channel = channel_block * channels_per_group;
    const uint local = gl_LocalInvocationID.x;

    // Cooperatively stage four [C] weight rows.  All workgroups in this
    // dispatch take this uniform path, so the barrier is well defined.
    const uint weight_count = channels_per_group * params.right_per_batch;
    for (uint index = local; index < weight_count; index += gl_WorkGroupSize.x) {
      const uint output_channel = first_channel + index / params.right_per_batch;
      if (output_channel < params.right_batch_stride) {
        pointwise_weights[index] = (params.mode == 29u || params.mode == 30u)
            ? e[output_channel * params.right_per_batch + index % params.right_per_batch]
            : b[output_channel * params.right_per_batch + index % params.right_per_batch];
      }
    }
    barrier();

    const uint channel_lane = local / lanes_per_channel;
    const uint spatial_lane = local - channel_lane * lanes_per_channel;
    const uint output_channel = first_channel + channel_lane;
    const uint spatial = spatial_block * spatial_per_group + spatial_lane * 4u;
    if (output_channel >= params.right_batch_stride || spatial >= params.right_repeat ||
        gl_WorkGroupID.y >= params.batches) return;

    const uint batch = gl_WorkGroupID.y;
    const uint input_count = params.right_per_batch * params.right_repeat;
    const uint output_base = batch * params.count + output_channel * params.right_repeat + spatial;
    if (spatial + 4u <= params.right_repeat) {
      const uint input_base = batch * input_count + spatial;
      vec4 value = vec4((params.mode == 29u || params.mode == 30u)
          ? e[params.right_batch_stride * params.right_per_batch + output_channel]
          : c[output_channel]);
      for (uint input_channel = 0u; input_channel < params.right_per_batch; ++input_channel) {
        const uint source = input_base + input_channel * params.right_repeat;
        value += vec4((params.mode == 29u || params.mode == 30u) ? d[source] : a[source],
                      (params.mode == 29u || params.mode == 30u) ? d[source + 1u] : a[source + 1u],
                      (params.mode == 29u || params.mode == 30u) ? d[source + 2u] : a[source + 2u],
                      (params.mode == 29u || params.mode == 30u) ? d[source + 3u] : a[source + 3u]) *
                 vec4(pointwise_weights[channel_lane * params.right_per_batch + input_channel]);
      }
      if (params.mode == 5u || params.mode == 6u || params.mode == 9u) {
        value += vec4(e[output_base], e[output_base + 1u], e[output_base + 2u],
                      e[output_base + 3u]);
      }
      if (params.mode == 4u || params.mode == 6u) value = max(value, vec4(0.0));
      if (params.mode == 7u || params.mode == 9u) value *= 1.0 / (1.0 + exp(-value));
      if (params.mode == 10u) value = 1.0 / (1.0 + exp(-value));
      if (params.mode == 11u) value = clamp(uintBitsToFloat(params.operation0) * value +
                                             vec4(uintBitsToFloat(params.operation1)),
                                             vec4(0.0), vec4(1.0));
      if (params.mode == 12u) value *= clamp(uintBitsToFloat(params.operation0) * value +
                                              vec4(uintBitsToFloat(params.operation1)),
                                              vec4(0.0), vec4(1.0));
      if (params.mode == 30u) value = approximate_gelu(value);
      if (params.mode == 55u) value = vec4(
          0.5 * value.x * (1.0 + erf_fp32(value.x * 0.7071067811865475)),
          0.5 * value.y * (1.0 + erf_fp32(value.y * 0.7071067811865475)),
          0.5 * value.z * (1.0 + erf_fp32(value.z * 0.7071067811865475)),
          0.5 * value.w * (1.0 + erf_fp32(value.w * 0.7071067811865475)));
      if (params.mode == 29u || params.mode == 30u) {
        a[output_base] = value.x;
        a[output_base + 1u] = value.y;
        a[output_base + 2u] = value.z;
        a[output_base + 3u] = value.w;
      } else {
        d[output_base] = value.x;
        d[output_base + 1u] = value.y;
        d[output_base + 2u] = value.z;
        d[output_base + 3u] = value.w;
      }
    } else {
      for (uint lane = 0u; spatial + lane < params.right_repeat; ++lane) {
        float value = (params.mode == 29u || params.mode == 30u)
            ? e[params.right_batch_stride * params.right_per_batch + output_channel]
            : c[output_channel];
        const uint input_base = batch * input_count + spatial + lane;
        for (uint input_channel = 0u; input_channel < params.right_per_batch; ++input_channel) {
          value += ((params.mode == 29u || params.mode == 30u) ? d[input_base + input_channel * params.right_repeat]
                                       : a[input_base + input_channel * params.right_repeat]) *
                   pointwise_weights[channel_lane * params.right_per_batch + input_channel];
        }
        if (params.mode == 5u || params.mode == 6u || params.mode == 9u) value += e[output_base + lane];
        if (params.mode == 4u || params.mode == 6u) value = max(value, 0.0);
        if (params.mode == 7u || params.mode == 9u) value *= 1.0 / (1.0 + exp(-value));
        if (params.mode == 10u) value = 1.0 / (1.0 + exp(-value));
        if (params.mode == 11u) value = clamp(uintBitsToFloat(params.operation0) * value +
                                               uintBitsToFloat(params.operation1), 0.0, 1.0);
        if (params.mode == 12u) value *= clamp(uintBitsToFloat(params.operation0) * value +
                                               uintBitsToFloat(params.operation1), 0.0, 1.0);
        if (params.mode == 30u) value = approximate_gelu_scalar(value);
        if (params.mode == 55u) value = 0.5 * value * (1.0 + erf_fp32(value * 0.7071067811865475));
        if (params.mode == 29u || params.mode == 30u) a[output_base + lane] = value;
        else d[output_base + lane] = value;
      }
    }
    return;
  }
  const uint index = gl_GlobalInvocationID.x * 4u;
  const uint batch = gl_GlobalInvocationID.y;
  if (index >= params.count || batch >= params.batches) return;
  const uint offset = batch * params.count + index;
  if (params.mode == 5u || params.mode == 6u || params.mode == 9u) {
    // The residual lives in a separate read-only buffer, so the output remains
    // non-aliased and every invocation owns one final output value.
    const uint input_count = params.right_per_batch * params.right_repeat;
    // Just like the non-residual pointwise path below, a normal OCR feature
    // plane supplies four contiguous spatial values.  Keep those four lanes
    // together through both the projection and the residual add: this reduces
    // loop/control overhead and lets the driver form vector FMAs.  The scalar
    // path deliberately handles channel boundaries and odd-width tails so the
    // NCHW addressing and FP32 accumulation order remain unchanged.
    if (index + 4u <= params.count &&
        (index % params.right_repeat) + 4u <= params.right_repeat) {
      const uint output_channel = index / params.right_repeat;
      const uint spatial = index % params.right_repeat;
      const uint output_offset = batch * params.count + index;
      vec4 value = vec4(c[output_channel]) +
          vec4(e[output_offset], e[output_offset + 1u],
               e[output_offset + 2u], e[output_offset + 3u]);
      const uint weight_base = output_channel * params.right_per_batch;
      const uint input_base = batch * input_count + spatial;
      for (uint input_channel = 0u; input_channel < params.right_per_batch; ++input_channel) {
        const uint source = input_base + input_channel * params.right_repeat;
        value += vec4(a[source], a[source + 1u], a[source + 2u], a[source + 3u]) *
                 vec4(b[weight_base + input_channel]);
      }
      if (params.mode == 6u) value = max(value, vec4(0.0));
      else if (params.mode == 9u) value = value / (vec4(1.0) + exp(-value));
      d[output_offset] = value.x;
      d[output_offset + 1u] = value.y;
      d[output_offset + 2u] = value.z;
      d[output_offset + 3u] = value.w;
      return;
    }
    for (uint lane = 0u; index + lane < params.count; ++lane) {
      const uint output_index = index + lane;
      const uint output_channel = output_index / params.right_repeat;
      const uint spatial = output_index % params.right_repeat;
      const uint output_offset = batch * params.count + output_index;
      float value = c[output_channel] + e[output_offset];
      const uint weight_base = output_channel * params.right_per_batch;
      const uint input_base = batch * input_count + spatial;
      for (uint input_channel = 0u; input_channel < params.right_per_batch; ++input_channel) {
        value += a[input_base + input_channel * params.right_repeat] *
                 b[weight_base + input_channel];
      }
      d[output_offset] = params.mode == 6u ? max(value, 0.0) :
          (params.mode == 9u ? value / (1.0 + exp(-value)) : value);
    }
    return;
  }
  if (params.mode == 3u || params.mode == 4u || params.mode == 7u ||
      params.mode == 10u || params.mode == 11u || params.mode == 12u ||
      params.mode == 29u || params.mode == 30u) {
    const uint input_count = params.right_per_batch * params.right_repeat;
    // The normal pointwise case has long contiguous spatial planes.  Compute
    // four adjacent positions of one output channel together: this turns the
    // inner dot product into vec4 FMA-friendly arithmetic and keeps the
    // scalar path only for a channel boundary/tail.
    if (index + 4u <= params.count &&
        (index % params.right_repeat) + 4u <= params.right_repeat) {
      const uint output_channel = index / params.right_repeat;
      const uint spatial = index % params.right_repeat;
      vec4 value = vec4((params.mode == 29u || params.mode == 30u)
          ? e[params.right_batch_stride * params.right_per_batch + output_channel]
          : c[output_channel]);
      const uint weight_base = output_channel * params.right_per_batch;
      const uint input_base = batch * input_count + spatial;
      for (uint input_channel = 0u; input_channel < params.right_per_batch; ++input_channel) {
        const uint source = input_base + input_channel * params.right_repeat;
        value += vec4((params.mode == 29u || params.mode == 30u) ? d[source] : a[source],
                      (params.mode == 29u || params.mode == 30u) ? d[source + 1u] : a[source + 1u],
                      (params.mode == 29u || params.mode == 30u) ? d[source + 2u] : a[source + 2u],
                      (params.mode == 29u || params.mode == 30u) ? d[source + 3u] : a[source + 3u]) *
                 vec4((params.mode == 29u || params.mode == 30u) ? e[weight_base + input_channel]
                                          : b[weight_base + input_channel]);
      }
      if (params.mode == 4u) value = max(value, vec4(0.0));
      else if (params.mode == 7u) value = value / (vec4(1.0) + exp(-value));
      else if (params.mode == 10u) value = 1.0 / (vec4(1.0) + exp(-value));
      else if (params.mode == 11u) value = clamp(uintBitsToFloat(params.operation0) * value +
                                                  vec4(uintBitsToFloat(params.operation1)),
                                                  vec4(0.0), vec4(1.0));
      else if (params.mode == 12u) value *= clamp(uintBitsToFloat(params.operation0) * value +
                                                   vec4(uintBitsToFloat(params.operation1)),
                                                   vec4(0.0), vec4(1.0));
      if (params.mode == 30u) value = approximate_gelu(value);
      if (params.mode == 29u || params.mode == 30u) {
        a[offset] = value.x;
        a[offset + 1u] = value.y;
        a[offset + 2u] = value.z;
        a[offset + 3u] = value.w;
      } else {
        d[offset] = value.x;
        d[offset + 1u] = value.y;
        d[offset + 2u] = value.z;
        d[offset + 3u] = value.w;
      }
      return;
    }
    for (uint lane = 0u; index + lane < params.count; ++lane) {
      const uint output_index = index + lane;
      const uint output_channel = output_index / params.right_repeat;
      const uint spatial = output_index % params.right_repeat;
      float value = (params.mode == 29u || params.mode == 30u)
          ? e[params.right_batch_stride * params.right_per_batch + output_channel]
          : c[output_channel];
      const uint weight_base = output_channel * params.right_per_batch;
      const uint input_base = batch * input_count + spatial;
      for (uint input_channel = 0u; input_channel < params.right_per_batch; ++input_channel) {
        value += ((params.mode == 29u || params.mode == 30u) ? d[input_base + input_channel * params.right_repeat]
                                     : a[input_base + input_channel * params.right_repeat]) *
                 ((params.mode == 29u || params.mode == 30u) ? e[weight_base + input_channel]
                                      : b[weight_base + input_channel]);
      }
      float final_value = params.mode == 4u ? max(value, 0.0) :
          (params.mode == 7u ? value / (1.0 + exp(-value)) :
           (params.mode == 10u ? 1.0 / (1.0 + exp(-value)) :
            (params.mode == 11u ? clamp(uintBitsToFloat(params.operation0) * value +
                                         uintBitsToFloat(params.operation1), 0.0, 1.0) :
             (params.mode == 12u ? value * clamp(uintBitsToFloat(params.operation0) * value +
                                                  uintBitsToFloat(params.operation1), 0.0, 1.0) : value))));
      if (params.mode == 30u) final_value = approximate_gelu_scalar(final_value);
      if (params.mode == 29u || params.mode == 30u) a[offset + lane] = final_value;
      else d[offset + lane] = final_value;
    }
    return;
  }
  if (params.mode == 1u || params.mode == 2u) {
    if (index + 4u <= params.count &&
        (index % params.right_repeat) + 4u <= params.right_repeat) {
      vec4 left = vec4(a[offset], a[offset + 1u], a[offset + 2u], a[offset + 3u]);
      const uint coefficient_offset = params.right_batch_stride == 0u
          ? 0u : batch * params.right_batch_stride;
      const uint channel = index / params.right_repeat;
      left = left * vec4(b[coefficient_offset + channel]) + vec4(c[coefficient_offset + channel]);
      if (params.mode == 2u) left = left / (vec4(1.0) + exp(-left));
      a[offset] = left.x;
      a[offset + 1u] = left.y;
      a[offset + 2u] = left.z;
      a[offset + 3u] = left.w;
      return;
    }
    for (uint lane = 0u; index + lane < params.count; ++lane) {
      const uint coefficient_offset = params.right_batch_stride == 0u
          ? 0u : batch * params.right_batch_stride;
      const uint channel = (index + lane) / params.right_repeat;
      float value = a[offset + lane] * b[coefficient_offset + channel] +
                    c[coefficient_offset + channel];
      if (params.mode == 2u) value = value / (1.0 + exp(-value));
      a[offset + lane] = value;
    }
    return;
  }
  if (params.mode == 8u) {
    if (index + 4u <= params.count &&
        (index % params.right_repeat) + 4u <= params.right_repeat) {
      const uint coefficient_offset = params.right_batch_stride == 0u
          ? 0u : batch * params.right_batch_stride;
      const uint channel = index / params.right_repeat;
      vec4 value = vec4(a[offset], a[offset + 1u], a[offset + 2u], a[offset + 3u]);
      value = value * vec4(b[coefficient_offset + channel]) +
          vec4(c[coefficient_offset + channel]);
      value = value / (vec4(1.0) + exp(-value));
      const vec4 right = vec4(d[offset], d[offset + 1u], d[offset + 2u], d[offset + 3u]);
      value = apply_binary(value, right, params.operation0);
      a[offset] = value.x;
      a[offset + 1u] = value.y;
      a[offset + 2u] = value.z;
      a[offset + 3u] = value.w;
      return;
    }
    for (uint lane = 0u; index + lane < params.count; ++lane) {
      const uint coefficient_offset = params.right_batch_stride == 0u
          ? 0u : batch * params.right_batch_stride;
      const uint channel = (index + lane) / params.right_repeat;
      float value = a[offset + lane] * b[coefficient_offset + channel] +
          c[coefficient_offset + channel];
      value = value / (1.0 + exp(-value));
      a[offset + lane] = apply_binary_scalar(value, d[offset + lane], params.operation0);
    }
    return;
  }
  // Most OCR planes are divisible by four. Keep the last 1--3 elements on a
  // scalar path so no shader ever reads past an allocation.
  if (params.right_repeat == 1u && index + 4u <= params.count) {
    vec4 left = vec4(a[offset], a[offset + 1u], a[offset + 2u], a[offset + 3u]);
    const vec4 right = vec4(b[offset], b[offset + 1u], b[offset + 2u], b[offset + 3u]);
    left = apply_binary(left, right, params.operation0);
    if (params.steps > 1u) left = apply_binary(left, right, params.operation1);
    if (params.steps > 2u) left = apply_binary(left, right, params.operation2);
    if (params.steps > 3u) left = apply_binary(left, right, params.operation3);
    a[offset] = left.x;
    a[offset + 1u] = left.y;
    a[offset + 2u] = left.z;
    a[offset + 3u] = left.w;
    return;
  }
  // A channel/gate broadcast is normally a long contiguous run (H*W).  Keep
  // it vectorized whenever all four values belong to the same run; the small
  // boundary fragment below remains scalar and exact.
  if (params.right_repeat >= 4u && index + 4u <= params.count &&
      (index % params.right_repeat) + 4u <= params.right_repeat) {
    vec4 left = vec4(a[offset], a[offset + 1u], a[offset + 2u], a[offset + 3u]);
    const uint right_offset = params.right_batch_stride == 0u
        ? 0u : batch * params.right_batch_stride;
    const float scalar_right = b[right_offset + index / params.right_repeat];
    const vec4 right = vec4(scalar_right);
    left = apply_binary(left, right, params.operation0);
    if (params.steps > 1u) left = apply_binary(left, right, params.operation1);
    if (params.steps > 2u) left = apply_binary(left, right, params.operation2);
    if (params.steps > 3u) left = apply_binary(left, right, params.operation3);
    a[offset] = left.x;
    a[offset + 1u] = left.y;
    a[offset + 2u] = left.z;
    a[offset + 3u] = left.w;
    return;
  }
  for (uint lane = 0u; index + lane < params.count; ++lane) {
    float value = a[offset + lane];
    const float right = params.right_repeat == 1u
        ? b[offset + lane]
        : b[(params.right_batch_stride == 0u ? 0u : batch * params.right_batch_stride) +
            (index + lane) / params.right_repeat];
    value = apply_binary_scalar(value, right, params.operation0);
    if (params.steps > 1u) value = apply_binary_scalar(value, right, params.operation1);
    if (params.steps > 2u) value = apply_binary_scalar(value, right, params.operation2);
    if (params.steps > 3u) value = apply_binary_scalar(value, right, params.operation3);
    a[offset + lane] = value;
  }
}
